# QuantBot ML — Configuração
# Copie para .env e preencha com seus dados reais
# NUNCA commite o .env no GitHub

# BRAPI.DEV — Dados da B3 (cadastro gratuito em brapi.dev/dashboard)
# Sem token, só PETR4, VALE3, ITUB4 e MGLU3 funcionam (modo demo).
# Para varrer FIIs e as +4000 ações da B3, o token gratuito é necessário.
BRAPI_TOKEN=

# SENTIMENTO COM IA (FinBERT-PT-BR via PyTorch) — opcional
# Ligue com 1 para usar deep learning no sentimento das notícias.
# Sem isto (ou sem torch/transformers), o sistema usa análise léxica.
QUANTBOT_USE_FINBERT=0
# Modelo do Hugging Face. Padrão: português brasileiro (recomendado).
# Alternativa em inglês: ProsusAI/finbert
QUANTBOT_FINBERT_MODEL=lucas-leme/FinBERT-PT-BR
# Opcional: token do Hugging Face para download mais rápido / sem rate limit
HF_TOKEN=

# TELEGRAM — Relatórios automáticos
# Como criar: @BotFather no Telegram → /newbot → copie o token
QUANTBOT_TELEGRAM_TOKEN=
QUANTBOT_TELEGRAM_CHAT_ID=

# EMAIL — Alternativo ao Telegram
QUANTBOT_EMAIL_FROM=
QUANTBOT_EMAIL_TO=
QUANTBOT_EMAIL_PASSWORD=
QUANTBOT_EMAIL_SMTP=smtp.gmail.com

# PORTFÓLIO
CAPITAL_INICIAL=1000
META_RENDA_MENSAL=200
APORTE_MENSAL=100

# RISCO (limites automáticos)
MAX_DRAWDOWN_TOTAL_PCT=20
MAX_DRAWDOWN_DIARIO_PCT=5
MAX_POSICAO_UNICA_PCT=25
MAX_TRADES_POR_DIA=3

# MODO: paper (análise apenas) ou live (atualiza portfólio real)
BOT_MODE=paper
LOG_LEVEL=INFO
